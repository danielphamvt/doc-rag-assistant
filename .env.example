# --- Domain Profile Configuration ---
# Select the active domain content pack (subdirectory under profiles/).
# Each profile encapsulates prompts, streaming markers, keywords, and display
# strings for a specific domain (EU AI Act, Vietnamese law, company policies, ...).
RAG_PROFILE=eu_ai_act

# --- LLM Provider Configuration ---
# Supported providers: ollama, openai, anthropic, google, zai
LLM_PROVIDER=ollama

# API Keys (only required for your selected cloud provider)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override model per provider (defaults are configured in config.py)
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GOOGLE_MODEL=gemini-2.5-flash

# Z AI configuration (Anthropic-compatible endpoint, when LLM_PROVIDER=zai)
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=myapi_key
# ANTHROPIC_MODEL=glm-4.7

# Path to log JSON prompts sent to the LLM (for debugging).
# Leave empty to disable logging. Example: "llm_log/"
LLM_PROMPT_LOG_PATH=""

# --- Hardware Acceleration Configuration ---
# Options: auto (default), cuda, mps, cpu
# - auto: Automatically picks optimal device (NVIDIA CUDA -> Apple Silicon MPS -> CPU)
# - cuda: Enforces NVIDIA GPU acceleration (Linux/Windows server)
# - mps: Enforces Apple Silicon GPU acceleration (macOS Metal)
# - cpu: Runs completely on CPU (Docker, cloud VMs without GPU)
#
# DEVICE: Global device setting
# DEVICE=auto
#
# EMBEDDING_DEVICE: Device for dense embeddings (Qwen3-Embedding)
# EMBEDDING_DEVICE=auto
#
# RERANKER_DEVICE: Device for CrossEncoder reranker (bge-reranker)
# (Note: On macOS, reranker defaults to CPU to avoid Metal GPU threading conflicts)
# RERANKER_DEVICE=auto

# --- Storage & Directories Configuration ---
# Base directory for storing per-profile corpus, caches, parent store, and vector DB
# DATA_DIR=data
# Directory containing raw corpus documents (.pdf, .docx, .txt, .md)
# DOCS_DIR=data/docs_vietnamese_law
# Markdown conversion cache directory
# MARKDOWN_DIR=data/markdown_docs_vietnamese_law
# Directory storing JSON parent chunks for full-context retrieval
# PARENT_STORE_PATH=data/parent_store_vietnamese_law
# Local storage path for Qdrant vector database
# QDRANT_PATH=data/qdrant_db_vietnamese_law
# Qdrant collection name for child chunks
# CHILD_COLLECTION=child_chunks_vietnamese_law

# --- Retrieval Model Configuration (Embedding & Reranker) ---
# (Note: Re-run ingestion with --clean if you change embedding models:
#  python db/document_processor.py --clean)
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# RERANKER_MODEL=BAAI/bge-reranker-base
# Batch size for embedding encoding (keep small to avoid MPS OOM on macOS)
# EMBEDDING_BATCH_SIZE=32
# Candidate child chunks retrieved from Qdrant prior to reranking
# RETRIEVAL_CANDIDATES=25
# Default number of parent documents returned by the search_documents tool
# DEFAULT_SEARCH_LIMIT=3

# --- Document Indexing & Chunking Configuration ---
# Tuned for structured articles (e.g. legal codes: mean ~1150 chars, median ~756 chars)
# CHILD_CHUNK_SIZE=400
# CHILD_CHUNK_OVERLAP=80
# MIN_PARENT_SIZE=500
# MAX_PARENT_SIZE=1500
# Batch size for indexing chunks into Qdrant
# INDEX_BATCH_SIZE=100

# --- Pipeline Thresholds (Agent & History) ---
# Maximum history messages retained before summarization
# MAX_HISTORY_MESSAGES=10
# Maximum history tokens before summarization
# MAX_HISTORY_TOKENS=10000
# Token threshold to trigger research context compression
# COMPRESS_TOKEN_THRESHOLD=100000
# Context compression growth factor based on existing summary size
# TOKEN_GROWTH_FACTOR=0.9
# Maximum tool calls allowed per single agent turn
# MAX_TOOL_CALLS=8
# Maximum orchestrator iterations
# MAX_ITERATIONS=5
# LangGraph recursion limit per conversation
# RECURSION_LIMIT=50

# --- Internet Search Configuration ---
# Maximum timeout (seconds) for each DuckDuckGo query
# SEARCH_TIMEOUT_SECONDS=30
# Maximum number of results per internet search query
# SEARCH_MAX_RESULTS=3

# --- Web Server Configuration ---
# Host and port for the Gradio/FastAPI web interface
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860

# --- Chat History Persistence ---
# SQLite database path for persisting conversations
# CHAT_HISTORY_PATH=db/chat_history.db
# Retention cap: maximum number of recent conversations kept (oldest pruned)
# MAX_STORED_CONVERSATIONS=25
